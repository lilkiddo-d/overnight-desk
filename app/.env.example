# Overnight Desk frontend configuration. Copy to app/.env.local for local development.
# All values are public (inlined into the browser bundle at build time). Never put secrets here.

# Default chain: 4663 = Robinhood Chain mainnet, 31337 = local anvil fork (http://127.0.0.1:8571).
# With 31337 the wallet can also switch to mainnet; with 4663 the local fork is not offered.
NEXT_PUBLIC_CHAIN_ID=4663

# Optional RPC override for the default chain (the public RPC is rate-limited and "not for production use").
# Example: https://robinhood-mainnet.g.alchemy.com/v2/<your-key>   (this key is visible to every visitor)
NEXT_PUBLIC_RPC_URL=

# Optional WalletConnect Cloud project id (https://cloud.reown.com). Empty => injected browser wallets only.
NEXT_PUBLIC_WC_PROJECT_ID=

# Project token address. Empty => all token / staking UI is hidden. The /stake page additionally requires
# ProjectTokenHooks.isActive() to be true on-chain.
NEXT_PUBLIC_PROJECT_TOKEN=

# Comma-separated ISO-3166 alpha-2 country codes to geoblock via the x-vercel-ip-country header (e.g. US,CU,IR,KP,SY).
# Empty => no geoblock. /blocked and /risk stay reachable.
NEXT_PUBLIC_GEOBLOCK_COUNTRIES=
