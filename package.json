{
  "name": "overnight-desk",
  "private": true,
  "version": "0.1.0",
  "description": "On-chain repo market on Robinhood Chain: fixed-term, fixed-rate loans backed by tokenized stocks.",
  "scripts": {
    "build:contracts": "cd contracts && forge build",
    "test:contracts": "cd contracts && forge test",
    "coverage": "cd contracts && forge coverage --report summary --no-match-coverage \"(test|script)/\"",
    "abis": "node scripts/export-abis.mjs",
    "build:app": "pnpm --filter app build",
    "dev:app": "pnpm --filter app dev",
    "keeper": "pnpm --filter scripts keeper"
  },
  "packageManager": "pnpm@9.15.0"
}
