# RPC the keeper reads from and sends to. Use a provider endpoint in production (the public RPC is rate-limited).
KEEPER_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Seconds between ticks.
KEEPER_INTERVAL_SECONDS=60
# Foundry keystore name (created with: cast wallet import overnightdesk-keeper --interactive)
KEEPER_ACCOUNT=overnightdesk-keeper
# Optional: path to a file holding the keystore password (otherwise you are prompted once at start-up).
# Keep it chmod 600 and outside the repo.
# KEEPER_PASSWORD_FILE=/secure/path/keeper.pass
# Optional: override the deployment file (defaults to ../deployments/<chainId>.json)
# KEEPER_DEPLOYMENT=../deployments/4663.json
# Simulate only, never send (no keystore needed):
# KEEPER_DRY_RUN=1
# Local anvil fork only (chain 31337): sign with anvil's unlocked dev account, no key handling.
# KEEPER_UNLOCKED_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
